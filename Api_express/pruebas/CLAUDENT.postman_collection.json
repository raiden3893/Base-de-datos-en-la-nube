{
  "info": {
    "_postman_id": "e4d8fa28-825e-4aa5-a721-claudent32api",
    "name": "CLAUDENT - Actividad 3.2",
    "description": "Ejecutar en orden. POST guarda automáticamente el ID real en pacienteId; PATCH y DELETE reutilizan ese valor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "pacienteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Insertar paciente de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.expect(body.success).to.eql(true);",
              "pm.expect(body.data.id_paciente).to.be.a('number');",
              "pm.collectionVariables.set('pacienteId', body.data.id_paciente);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente\",\n  \"apellido\": \"Prueba Codex\",\n  \"fecha_nacimiento\": \"2002-05-15\",\n  \"telefono\": \"9991112233\",\n  \"correo\": \"paciente.codex@example.test\",\n  \"direccion\": \"Mérida, Yucatán\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/pacientes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pacientes"]
        }
      }
    },
    {
      "name": "2 - Consultar pacientes por apellido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.success).to.eql(true);",
              "pm.expect(body.data).to.be.an('array');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes?apellido=Prueba",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pacientes"],
          "query": [
            {
              "key": "apellido",
              "value": "Prueba"
            }
          ]
        }
      }
    },
    {
      "name": "3 - Actualizar paciente de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.success).to.eql(true);",
              "pm.expect(body.data.id_paciente).to.eql(Number(pm.collectionVariables.get('pacienteId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Paciente Actualizado\",\n  \"direccion\": \"Centro, Mérida, Yucatán\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{pacienteId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pacientes", "{{pacienteId}}"]
        }
      }
    },
    {
      "name": "4 - Eliminar paciente de prueba",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.success).to.eql(true);",
              "pm.collectionVariables.unset('pacienteId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/pacientes/{{pacienteId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "pacientes", "{{pacienteId}}"]
        }
      }
    }
  ]
}
